#!/usr/bin/env bash
set -euo pipefail

command -v glab >/dev/null || { echo '[]'; exit 0; }

lib="$(dirname "$(realpath "$0")")/../lib"

fields='nodes { iid title webUrl project { fullPath } author { name username } headPipeline { status } }'
query="
query {
  currentUser {
    authoredMergeRequests(state: opened, sort: CREATED_DESC) { $fields }
    reviewRequestedMergeRequests(state: opened, sort: CREATED_DESC) { $fields }
  }
}"

hosts=$(glab auth status 2>&1 | grep -E '^[^[:space:]]' || true)

for host in $hosts; do
  glab auth status --hostname "$host" >/dev/null 2>&1 || continue
  glab api --hostname "$host" graphql -f query="$query" | jq -c -L "$lib" '
    include "merge-request";
    def gitlab($role):
      { reference: ("!" + .iid),
        title,
        url: .webUrl,
        project: .project.fullPath,
        author: person(.author.name; .author.username),
        status: .headPipeline.status }
      | card($role; ["SUCCESS", "MANUAL", "SKIPPED"]; ["FAILED", "CANCELED"]);
    .data.currentUser
    | [(.authoredMergeRequests.nodes[] | gitlab("mine")),
       (.reviewRequestedMergeRequests.nodes[] | gitlab("review"))]'
done | jq -sc 'add // []'
