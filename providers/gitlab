#!/usr/bin/env bash
set -euo pipefail

command -v glab >/dev/null || { echo '[]'; exit 0; }

lib="$(dirname "$(realpath "$0")")/../lib"

fields='iid title webUrl project { fullPath } author { name username } headPipeline { status }'
conversation='createdAt project { userPermissions { pushCode } }
  discussions(first: 100) { nodes { resolvable resolved notes(first: 1) { nodes { system createdAt author { username bot } } } } }'
query="
query {
  currentUser {
    username
    authoredMergeRequests(state: opened, sort: CREATED_DESC) { nodes { $fields $conversation } }
    reviewRequestedMergeRequests(state: opened, sort: CREATED_DESC) { nodes { $fields } }
  }
}"

hosts=$(glab auth status 2>&1 | grep -E '^[^[:space:]]' || true)

for host in $hosts; do
  glab auth status --hostname "$host" >/dev/null 2>&1 || continue
  glab api --hostname "$host" graphql -f query="$query" | jq -c -L "$lib" '
    include "merge-request";
    def gitlab($role):
      { reference: ("!" + .iid),
        title,
        url: .webUrl,
        project: .project.fullPath,
        author: person(.author.name; .author.username),
        status: .headPipeline.status }
      | card($role; ["SUCCESS", "MANUAL", "SKIPPED"]; ["FAILED", "CANCELED"]);
    def from_others($me): select(.author.username != $me and (.author.bot | not));
    def conversation($me):
      [.discussions.nodes[] | { resolvable, resolved } + .notes.nodes[0]] as $openers
      | { createdAt,
          foreign: (.project.userPermissions.pushCode | not),
          waitingSince: waiting_since(
            [$openers[] | select(.resolvable and (.resolved | not)) | from_others($me) | .createdAt];
            [$openers[] | select((.resolvable or .system) | not) | from_others($me) | .createdAt];
            [$openers[] | select(.author.username == $me) | .createdAt] | max) };
    .data.currentUser
    | .username as $me
    | [(.authoredMergeRequests.nodes[] | (gitlab("mine") + conversation($me))),
       (.reviewRequestedMergeRequests.nodes[] | gitlab("review"))]'
done | jq -sc 'add // []'
