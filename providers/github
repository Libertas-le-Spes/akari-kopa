#!/usr/bin/env bash
set -euo pipefail

command -v gh >/dev/null || { echo '[]'; exit 0; }

lib="$(dirname "$(realpath "$0")")/../lib"

fields='number title url repository { nameWithOwner } author { login ... on User { name } } commits(last: 1) { nodes { commit { committedDate statusCheckRollup { state } } } }'
someone='author { __typename login }'
conversation="createdAt repository { viewerPermission }
  reviewThreads(first: 100) { nodes { isResolved comments(first: 1) { nodes { $someone createdAt } } } }
  comments(last: 100) { nodes { $someone createdAt } }
  reviews(last: 100) { nodes { $someone state body submittedAt } }"
query="
query {
  viewer {
    login
    pullRequests(states: OPEN, first: 50, orderBy: { field: CREATED_AT, direction: DESC }) { nodes { $fields $conversation } }
  }
  search(query: \"is:open is:pr review-requested:@me archived:false\", type: ISSUE, first: 50) { nodes { ... on PullRequest { $fields } } }
}"

hosts=$(gh auth status 2>&1 | grep -E '^[^[:space:]]' || true)

for host in $hosts; do
  gh auth status --hostname "$host" >/dev/null 2>&1 || continue
  gh api --hostname "$host" graphql -f query="$query" | jq -c -L "$lib" '
    include "merge-request";
    def github($role):
      { reference: ("#" + (.number | tostring)),
        title,
        url,
        project: .repository.nameWithOwner,
        author: person(.author.name; .author.login),
        status: .commits.nodes[0].commit.statusCheckRollup.state }
      | card($role; ["SUCCESS"]; ["FAILURE", "ERROR"]);
    def from_others($me): select(.author.login != $me and .author.__typename != "Bot");
    def answered($me):
      [(.comments.nodes[], .reviews.nodes[]) | select(.author.login == $me) | .createdAt // .submittedAt]
      + [.commits.nodes[0].commit.committedDate]
      | max;
    def conversation($me):
      { createdAt,
        foreign: (.repository.viewerPermission | IN("ADMIN", "MAINTAIN", "WRITE") | not),
        waitingSince: waiting_since(
          [.reviewThreads.nodes[] | select(.isResolved | not) | .comments.nodes[0] | from_others($me) | .createdAt];
          [(.comments.nodes[] | from_others($me) | .createdAt),
           (.reviews.nodes[] | select(.state != "APPROVED" and .body != "") | from_others($me) | .submittedAt)];
          answered($me)) };
    .data
    | .viewer.login as $me
    | [(.viewer.pullRequests.nodes[] | (github("mine") + conversation($me))),
       (.search.nodes[] | select(.number) | github("review"))]'
done | jq -sc 'add // []'
