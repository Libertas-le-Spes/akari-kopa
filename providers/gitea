#!/usr/bin/env bash
set -euo pipefail

command -v tea >/dev/null || { echo '[]'; exit 0; }

lib="$(dirname "$(realpath "$0")")/../lib"
logins=$(tea logins list --output json 2>/dev/null | jq -r '.[].name' || true)

pull_requests() {
  local login=$1 role=$2 filter=$3
  tea api --login "$login" "/repos/issues/search?type=pulls&state=open&$filter=true&limit=50" \
    | jq -c '.[]' \
    | while read -r issue; do
        repo=$(jq -r '.repository.full_name' <<<"$issue")
        number=$(jq -r '.number' <<<"$issue")
        sha=$(tea api --login "$login" "/repos/$repo/pulls/$number" | jq -r '.head.sha')
        status=$(tea api --login "$login" "/repos/$repo/commits/$sha/status" | jq -c '.state')
        jq -c -L "$lib" --arg role "$role" --argjson status "$status" '
          include "merge-request";
          { reference: ("#" + (.number | tostring)),
            title,
            url: .html_url,
            project: .repository.full_name,
            author: person(.user.full_name; .user.login),
            status: $status }
          | card($role; ["success"]; ["failure", "error"])' <<<"$issue"
      done
}

while read -r login; do
  [ -n "$login" ] || continue
  pull_requests "$login" mine created
  pull_requests "$login" review review_requested
done <<<"$logins" | jq -sc '.'
