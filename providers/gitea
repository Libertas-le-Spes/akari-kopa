#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

command -v tea >/dev/null || { echo '[]'; exit 0; }

lib="$(dirname "$(realpath "$0")")/../lib"
now=$(date +%s)
since=$(date -u -d '-6 hours' +%FT%TZ)
logins=$(tea logins list --output json 2>/dev/null | jq -r '.[].name' || true)

search() {
  local login=$1 filter=$2 extra=$3
  tea api --login "$login" "/repos/issues/search?type=pulls&$filter=true&limit=50&$extra" | jq -c '.[]'
}

open_pull_requests() {
  local login=$1 role=$2 filter=$3
  search "$login" "$filter" state=open | while read -r issue; do
    repo=$(jq -r '.repository.full_name' <<<"$issue")
    number=$(jq -r '.number' <<<"$issue")
    sha=$(tea api --login "$login" "/repos/$repo/pulls/$number" | jq -r '.head.sha')
    status=$(tea api --login "$login" "/repos/$repo/commits/$sha/status" | jq -c '.state')
    jq -c -L "$lib" --arg role "$role" --argjson status "$status" '
      include "merge-request";
      { reference: ("#" + (.number | tostring)),
        title,
        url: .html_url,
        project: .repository.full_name,
        author: person(.user.full_name; .user.login),
        status: $status }
      | card($role; ["success"]; ["failure", "error"])' <<<"$issue"
  done
}

merged_pull_requests() {
  local login=$1 role=$2 filter=$3
  search "$login" "$filter" "state=closed&since=$since" | while read -r issue; do
    repo=$(jq -r '.repository.full_name' <<<"$issue")
    number=$(jq -r '.number' <<<"$issue")
    pull=$(tea api --login "$login" "/repos/$repo/pulls/$number")
    [ "$(jq -r '.merged' <<<"$pull")" = true ] || continue
    sha=$(jq -r '.merge_commit_sha' <<<"$pull")
    checks=$(tea api --login "$login" "/repos/$repo/commits/$sha/status")
    jq -c -L "$lib" --arg role "$role" --argjson pull "$pull" --argjson checks "$checks" --argjson now "$now" '
      include "merge-request";
      { reference: ("#" + (.number | tostring)),
        title,
        url: .html_url,
        project: .repository.full_name,
        author: person(.user.full_name; .user.login),
        status: (if ($checks.statuses | length) > 0 then $checks.state else null end),
        settled: ([$checks.statuses[]?.updated_at | select(.) | epoch] | max | if . then todate else null end),
        mergedAt: $pull.merged_at }
      | merged_card($role; ["success"]; ["failure", "error"]; $now)' <<<"$issue"
  done
}

while read -r login; do
  [ -n "$login" ] || continue
  open_pull_requests "$login" mine created
  open_pull_requests "$login" review review_requested
  merged_pull_requests "$login" mine created
  merged_pull_requests "$login" review review_requested
done <<<"$logins" | jq -sc '.'
