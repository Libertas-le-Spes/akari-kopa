#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

command -v secret-tool >/dev/null || { echo '[]'; exit 0; }
credentials=$(secret-tool lookup merge-requests bitbucket.org 2>/dev/null || true)
[ -n "$credentials" ] || { echo '[]'; exit 0; }

lib="$(dirname "$(realpath "$0")")/../lib"

cache="${XDG_CACHE_HOME:-$HOME/.cache}/kayu.merge-requests/bitbucket.json"
if [ -n "$(find "$cache" -mmin -5 2>/dev/null)" ]; then
  cat "$cache"
  exit 0
fi

api() {
  curl -sSfg -K - -G "https://api.bitbucket.org/2.0$1" "${@:2}" <<<"user = \"$credentials\""
}

statuses() {
  api "/repositories/$1/pullrequests/$2/statuses" --data-urlencode pagelen=100 | jq -c '[.values[].state]'
}

cards() {
  local role=$1
  jq -c '.values[]' | while read -r pull_request; do
    repo=$(jq -r '.destination.repository.full_name' <<<"$pull_request")
    id=$(jq -r '.id' <<<"$pull_request")
    status=$(statuses "$repo" "$id")
    jq -c -L "$lib" --arg role "$role" --argjson status "$status" '
      include "merge-request";
      { reference: ("#" + (.id | tostring)),
        title,
        url: .links.html.href,
        project: .destination.repository.full_name,
        author: .author.display_name,
        status: $status }
      | card($role; ["SUCCESSFUL"]; ["FAILED", "STOPPED"])' <<<"$pull_request"
  done
}

me=$(api /user | jq -r '.uuid')
workspaces=$(api /user/workspaces --data-urlencode pagelen=100 | jq -r '.values[].workspace.slug')
since=$(date -u -d "@$(( $(date +%s) - 30 * 86400 ))" +%Y-%m-%dT%H:%M:%S)

listing=$(
  for workspace in $workspaces; do
    api "/workspaces/$workspace/pullrequests/$me" --data-urlencode state=OPEN --data-urlencode pagelen=50 | cards mine
    api "/repositories/$workspace" \
      --data-urlencode role=member \
      --data-urlencode "q=updated_on > $since" \
      --data-urlencode sort=-updated_on \
      --data-urlencode pagelen=25 \
      | jq -r '.values[].full_name' \
      | while read -r repo; do
          api "/repositories/$repo/pullrequests" \
            --data-urlencode "q=state=\"OPEN\" AND reviewers.uuid=\"$me\"" \
            --data-urlencode pagelen=50 \
            | cards review
        done
  done | jq -sc '.'
)

mkdir -p "$(dirname "$cache")"
(umask 077 && printf '%s\n' "$listing" > "$cache")
printf '%s\n' "$listing"
