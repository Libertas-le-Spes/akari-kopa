#!/usr/bin/env bash
set -uo pipefail

export PATH="$PATH:$HOME/.local/bin:$HOME/.local/share/mise/shims"

providers="$(dirname "$(realpath "$0")")/providers"
results=$(mktemp -d)
trap 'rm -rf "$results"' EXIT

for provider in "$providers"/*; do
  name=$(basename "$provider")
  ("$provider" > "$results/$name" 2>/dev/null || rm -f "$results/$name") &
done
wait

found='[]'
failed='[]'

for provider in "$providers"/*; do
  name=$(basename "$provider")
  if jq -e 'type == "array"' "$results/$name" >/dev/null 2>&1; then
    found=$(jq -c --slurpfile more "$results/$name" --arg name "$name" '. + ($more[0] | map(. + { provider: $name }))' <<<"$found")
  else
    failed=$(jq -c --arg name "$name" '. + [$name]' <<<"$failed")
  fi
done

jq -nc --argjson mergeRequests "$found" --argjson failed "$failed" '{ $mergeRequests, $failed }'
