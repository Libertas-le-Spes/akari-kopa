#!/usr/bin/env bash
set -uo pipefail

export PATH="$PATH:$HOME/.local/bin"

here="$(dirname "$(realpath "$0")")"
providers="$here/providers"
results=$(mktemp -d)
trap 'rm -rf "$results"' EXIT

for provider in "$providers"/*; do
  name=$(basename "$provider")
  ("$provider" > "$results/$name" 2> "$results/$name.error" || rm -f "$results/$name") &
done
wait

found='[]'
failed='[]'

for provider in "$providers"/*; do
  name=$(basename "$provider")
  if jq -e 'type == "array"' "$results/$name" >/dev/null 2>&1; then
    found=$(jq -c --slurpfile more "$results/$name" --arg name "$name" '. + ($more[0] | map(. + { provider: $name }))' <<<"$found")
  else
    reason=$(grep -v '^[[:space:]]*$' "$results/$name.error" 2>/dev/null | tail -n 1 | cut -c 1-160)
    failed=$(jq -c --arg name "$name" --arg reason "${reason:-no answer}" '. + [{ provider: $name, reason: $reason }]' <<<"$failed")
  fi
done

jq -nc -L "$here/lib" --argjson mergeRequests "$found" --argjson failed "$failed" '
  include "orb";
  { mergeRequests: ($mergeRequests | on_the_bar(now)), $failed }'
